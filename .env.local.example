# Option 1: Vercel Supabase Integration naming (matches Vercel env vars)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJh...your-anon-key

# Option 2: Standard Next.js convention (also works)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...your-anon-key

# IMPORTANT:
# 1. Use the "anon public" key (starts with eyJh..., ~250 chars)
# 2. NOT the "service_role" secret key (starts with sb_secret_)
# 3. Get keys at: https://supabase.com/dashboard → Settings → API
# 4. App supports both naming conventions for Vercel compatibility

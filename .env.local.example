# Option 1: Standard Next.js convention (recommended for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...your-anon-key

# Option 2: Vercel convention (automatically works with Vercel integration)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=eyJh...your-anon-key

# IMPORTANT: Use the "anon public" key (starts with eyJh...)
# NOT the "service_role" secret key (starts with sb_secret_)
